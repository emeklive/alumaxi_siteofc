# Copie para .env.local (desenvolvimento) ou cadastre na Vercel:
# Project → Settings → Environment Variables. Nunca suba o .env.local para o GitHub.

# ===== Site =====
# Domínio oficial (PENDENTE). Sem ele, na Vercel o site usa o domínio *.vercel.app.
NEXT_PUBLIC_SITE_URL=

# ===== Canais oficiais (PENDENTES de confirmação pela empresa) =====
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
# WhatsApp comercial: só dígitos, com 55 + DDD. Vazio = número verificado no Google Maps.
NEXT_PUBLIC_WHATSAPP_NUMBER=5585998090245

# ===== Google =====
# Ex.: G-XXXXXXX. Só carrega depois que o visitante aceita os cookies.
NEXT_PUBLIC_GA_ID=
# Código de verificação do Google Search Console (método "tag HTML").
NEXT_PUBLIC_GSC_VERIFICATION=

# ===== Painel administrativo (/admin) =====
# Sem estas duas, o painel fica DESATIVADO.
ADMIN_PASSWORD=
# Texto aleatório com 32+ caracteres (gere com: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# ===== Banco de dados e arquivos (Supabase) — necessário na Vercel =====
# Sem Supabase, na Vercel os orçamentos/currículos ficam só temporariamente.
SUPABASE_URL=
# Chave "service_role": somente no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ===== Encaminhamento dos formulários (opcional) =====
# Recebe um JSON a cada orçamento/contato/candidatura (Make, Zapier, n8n...).
FORMS_WEBHOOK_URL=
